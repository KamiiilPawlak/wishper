# Skopiuj do .env i dopasuj wartości lokalnie. Nie commituj .env (patrz .gitignore).

# Postgres (patrz docker-compose.yml w repo root — db mapowana na localhost:5433,
# bo na tej maszynie port 5432 bywa zajęty przez natywny serwis Postgres)
DATABASE_URL=postgresql+asyncpg://wishper:wishper@localhost:5433/wishper

# Redis — broker Celery + cache statusów (PF3+)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage plików audio (lokalny filesystem na start, patrz ADR 0002)
STORAGE_PATH=/data/recordings

# faster-whisper (PF4+)
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_SIZE_MB=500

# NLP — streszczenie/słowa kluczowe/chunking (PF5+)
SUMMARY_MIN_SENTENCES=3
SUMMARY_MAX_SENTENCES=10
KEYWORDS_COUNT=10
CHUNK_DURATION_MINUTES=15
